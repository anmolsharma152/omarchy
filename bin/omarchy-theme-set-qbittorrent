#!/usr/bin/env python3
import os
import sys
import re

CONF_PATH = os.path.expanduser("~/.config/qBittorrent/qBittorrent.conf")
THEMES_DIR = os.path.expanduser("~/.config/qBittorrent/themes")
COLORS_TOML = os.path.expanduser("~/.local/state/omarchy/current/theme/colors.toml")
THEME_NAME_FILE = os.path.expanduser("~/.local/state/omarchy/current/theme.name")

if len(sys.argv) > 1 and sys.argv[1]:
    theme_name = sys.argv[1].strip().lower()
else:
    try:
        with open(THEME_NAME_FILE, "r") as f:
            theme_name = f.read().strip().lower()
    except Exception:
        theme_name = "catppuccin"

# 1. Inspect theme mode and background color directly from colors.toml
theme_mode = "dark"
bg_hex = ""
if os.path.exists(COLORS_TOML):
    try:
        with open(COLORS_TOML, "r", encoding="utf-8") as f:
            content = f.read()
            match_mode = re.search(r'mode\s*=\s*["\'](light|dark)["\']', content)
            if match_mode:
                theme_mode = match_mode.group(1).lower()
            match_bg = re.search(r'background\s*=\s*["\']#?([0-9a-fA-F]{6})["\']', content)
            if match_bg:
                bg_hex = match_bg.group(1).lower()
    except Exception:
        pass

# Check if background is inherently light (e.g. #d0d0c8, #faf4ed)
if bg_hex:
    try:
        r, g, b = int(bg_hex[:2], 16), int(bg_hex[2:4], 16), int(bg_hex[4:], 16)
        if (r * 299 + g * 587 + b * 114) / 1000 > 160:
            theme_mode = "light"
    except Exception:
        pass

# 2. Comprehensive 40-Theme Exact Palette Mapping
PITCH_BLACK_THEMES = {
    "vantablack", "matte-black", "solitude", "black_arch", "castle-on-a-lake",
    "cpunk", "dos-moos", "ghost-pastel", "hackerman", "last-horizon",
    "matrix", "ethereal", "retro-82", "futurist", "inkypinky"
}

FROST_SLATE_THEMES = {
    "nord", "lumon", "osaka-jade", "japan-night", "evergarden"
}

if theme_mode == "light" or theme_name in ("thegreek", "rose-pine", "catppuccin-latte", "flexoki-light", "lupine", "white"):
    theme_file = "mumble-lite.qbtheme"
elif theme_name in FROST_SLATE_THEMES:
    theme_file = "breeze-dark.qbtheme"
elif theme_name in PITCH_BLACK_THEMES:
    theme_file = "darkstylesheet.qbtheme"
else:
    # Rich dark themes: Catppuccin, Dracula, Fuchsblau, Batman, Biscuit De Mar, City 783, Event Horizon, Everforest, Gruvbox, Kanagawa, Mars, Miasma, Ristretto, Tokyo Night
    theme_file = "mumble-dark.qbtheme"

theme_path = os.path.join(THEMES_DIR, theme_file)

if not os.path.exists(CONF_PATH):
    sys.exit(0)

os.makedirs(THEMES_DIR, exist_ok=True)

with open(CONF_PATH, "r", encoding="utf-8", errors="ignore") as f:
    lines = f.readlines()

new_lines = []
in_preferences = False
has_use_custom = False
has_theme_path = False
preferences_found = False

for line in lines:
    stripped = line.strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        if in_preferences:
            if not has_use_custom:
                new_lines.append("General\\UseCustomUITheme=true\n")
            if not has_theme_path:
                new_lines.append(f"General\\CustomUIThemePath={theme_path}\n")
        in_preferences = (stripped == "[Preferences]")
        if in_preferences:
            preferences_found = True

    if in_preferences:
        if stripped.startswith("General\\UseCustomUITheme="):
            new_lines.append("General\\UseCustomUITheme=true\n")
            has_use_custom = True
            continue
        elif stripped.startswith("General\\CustomUIThemePath="):
            new_lines.append(f"General\\CustomUIThemePath={theme_path}\n")
            has_theme_path = True
            continue

    new_lines.append(line)

if in_preferences:
    if not has_use_custom:
        new_lines.append("General\\UseCustomUITheme=true\n")
    if not has_theme_path:
        new_lines.append(f"General\\CustomUIThemePath={theme_path}\n")

if not preferences_found:
    new_lines.append("\n[Preferences]\n")
    new_lines.append("General\\UseCustomUITheme=true\n")
    new_lines.append(f"General\\CustomUIThemePath={theme_path}\n")

with open(CONF_PATH, "w", encoding="utf-8") as f:
    f.writelines(new_lines)

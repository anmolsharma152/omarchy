#!/usr/bin/env python3
# omarchy:summary=Cycle focused window size through 50%, 66%, 100%, and 33% presets
# omarchy:examples=omarchy-window-size-cycle

import json, subprocess, sys, os, time

PRESETS = [
    {"ratio": 0.50, "label": "50% (1/2 Balanced)"},
    {"ratio": 0.666, "label": "66% (2/3 Master View)"},
    {"ratio": 1.00, "label": "100% (Full Tiled)"},
    {"ratio": 0.333, "label": "33% (1/3 Sidebar View)"},
]

def run(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True).stdout.strip()

def dispatch(cmd):
    subprocess.run(f"hyprctl dispatch '{cmd}'", shell=True, capture_output=True)

def notify(title, message):
    subprocess.run(["omarchy-notification-send", "-g", "󱂬", title, message], check=False)

def main():
    active_raw = run("hyprctl activewindow -j")
    if not active_raw:
        return
    try:
        active = json.loads(active_raw)
    except Exception:
        return

    address = active.get("address")
    if not address:
        return

    curr_w, curr_h = active.get("size", [0, 0])
    is_floating = active.get("floating", False)
    fullscreen_mode = active.get("fullscreen", 0)
    ws_id = active.get("workspace", {}).get("id")

    clients_raw = run("hyprctl clients -j")
    try:
        clients = json.loads(clients_raw)
        ws_clients = [c for c in clients if c.get("workspace", {}).get("id") == ws_id and not c.get("hidden", False)]
    except Exception:
        ws_clients = [active]

    is_single_window = len(ws_clients) <= 1

    mons_raw = run("hyprctl monitors -j")
    try:
        mons = json.loads(mons_raw)
        mon = next((m for m in mons if m.get("focused")), mons[0])
    except Exception:
        return

    mon_w = mon.get("width", 1920)
    mon_h = mon.get("height", 1080)
    scale = mon.get("scale", 1.0) or 1.0
    logical_w = mon_w / scale
    logical_h = mon_h / scale

    # State directory per window to track last applied preset index
    state_dir = os.path.expanduser("~/.local/state/omarchy/window-size")
    os.makedirs(state_dir, exist_ok=True)
    state_file = os.path.join(state_dir, f"{address.replace(':', '_')}.idx")

    current_idx = -1
    if os.path.exists(state_file):
        try:
            with open(state_file) as f:
                current_idx = int(f.read().strip())
        except Exception:
            current_idx = -1

    if current_idx < 0:
        if is_single_window and not is_floating:
            # Current is full tiled (100%), start at 50%
            next_idx = 0
        else:
            curr_ratio = curr_w / logical_w if logical_w else 0.5
            diffs = [abs(p["ratio"] - curr_ratio) for p in PRESETS]
            closest_idx = diffs.index(min(diffs))
            next_idx = (closest_idx + 1) % len(PRESETS)
    else:
        next_idx = (current_idx + 1) % len(PRESETS)

    target_preset = PRESETS[next_idx]
    target_ratio = target_preset["ratio"]
    target_label = target_preset["label"]

    with open(state_file, "w") as f:
        f.write(str(next_idx))

    if is_single_window:
        if target_ratio >= 0.99:
            # 100%: Tile back
            if is_floating:
                dispatch("hl.dsp.window.toggle_floating()")
        else:
            # 33%, 50%, 66%: Float, resize, and center
            if not is_floating:
                dispatch("hl.dsp.window.toggle_floating()")
            target_w = int(logical_w * target_ratio)
            target_h = int(logical_h * target_ratio)
            dispatch(f"hl.dsp.window.resize({{ x = {target_w}, y = {target_h}, relative = false }})")
            dispatch("hl.dsp.window.center()")
            dispatch("hl.dsp.window.bring_to_top()")
    else:
        # Multiple windows on workspace
        if is_floating:
            if target_ratio >= 0.99:
                dispatch("hl.dsp.window.toggle_floating()")
            else:
                target_w = int(logical_w * target_ratio)
                target_h = int(logical_h * target_ratio)
                dispatch(f"hl.dsp.window.resize({{ x = {target_w}, y = {target_h}, relative = false }})")
                dispatch("hl.dsp.window.center()")
                dispatch("hl.dsp.window.bring_to_top()")
        else:
            # Tiled with multiple windows
            if target_ratio >= 0.99:
                if fullscreen_mode == 0:
                    dispatch('hl.dsp.window.fullscreen({ mode = "maximized" })')
            else:
                if fullscreen_mode != 0:
                    dispatch('hl.dsp.window.fullscreen({ mode = "maximized" })') # unmaximize
                target_w = int(logical_w * target_ratio)
                delta_x = target_w - curr_w
                if delta_x != 0:
                    dispatch(f"hl.dsp.window.resize({{ x = {delta_x}, y = 0, relative = true }})")

    notify("Window Size", f"Width set to {target_label}")

if __name__ == "__main__":
    main()

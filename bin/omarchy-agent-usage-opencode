#!/usr/bin/env python3
import sqlite3, os, json
from datetime import datetime, timedelta

db_path = os.path.expanduser("~/.local/share/opencode/opencode.db")
now = datetime.now().astimezone()
today_str = now.strftime("%Y-%m-%d")

recent_days = {}
for i in range(6, -1, -1):
    d_str = (now - timedelta(days=i)).strftime("%Y-%m-%d")
    recent_days[d_str] = 0

today_tokens = 0
today_models = {}
today_prompts = 0
today_sessions = set()
model_breakdown = {}

if os.path.exists(db_path):
    try:
        conn = sqlite3.connect(db_path)
        cur = conn.cursor()
        cur.execute("SELECT id, session_id, time_created, data FROM message")
        for row in cur.fetchall():
            msg_id, session_id, time_created, raw_data = row
            try:
                data = json.loads(raw_data)
            except:
                continue

            if not isinstance(data, dict):
                continue

            role = data.get("role")
            dt = datetime.fromtimestamp(time_created / 1000.0).astimezone()
            d_key = dt.strftime("%Y-%m-%d")
            is_today = (d_key == today_str)

            if role == "user":
                if is_today:
                    today_prompts += 1
                continue

            if role == "assistant":
                model_raw = data.get("modelID") or data.get("model") or "big-pickle"
                if isinstance(model_raw, dict):
                    model_raw = model_raw.get("modelID") or model_raw.get("id") or "big-pickle"
                
                m_name = "Big Pickle" if "pickle" in str(model_raw).lower() else str(model_raw)

                tokens = data.get("tokens") or {}
                if isinstance(tokens, dict):
                    t_in = tokens.get("input", 0) or 0
                    t_out = tokens.get("output", 0) or 0
                    t_reas = tokens.get("reasoning", 0) or 0
                    cache = tokens.get("cache") or {}
                    t_read = cache.get("read", 0) if isinstance(cache, dict) else 0
                    t_write = cache.get("write", 0) if isinstance(cache, dict) else 0
                else:
                    t_in = t_out = t_reas = t_read = t_write = 0

                t_total = t_in + t_out + t_reas + t_read + t_write
                if d_key in recent_days:
                    recent_days[d_key] += t_total

                if is_today:
                    today_tokens += t_total
                    today_models[m_name] = today_models.get(m_name, 0) + t_total
                    today_sessions.add(session_id)
                    if m_name not in model_breakdown:
                        model_breakdown[m_name] = {
                            "inputTokens": 0,
                            "outputTokens": 0,
                            "cacheReadInputTokens": 0,
                            "cacheCreationInputTokens": 0
                        }
                    model_breakdown[m_name]["inputTokens"] += t_in
                    model_breakdown[m_name]["outputTokens"] += t_out + t_reas
                    model_breakdown[m_name]["cacheReadInputTokens"] += t_read
                    model_breakdown[m_name]["cacheCreationInputTokens"] += t_write

        conn.close()
    except:
        pass

window_reset = (now + timedelta(hours=2, minutes=14)).strftime("%Y-%m-%dT%H:%M:%S%z")

record = {
    "schemaVersion": 1,
    "id": "opencode",
    "name": "OpenCode",
    "tierLabel": "Free (Big Pickle)",
    "ready": True,
    "hasLocalStats": True,
    "todayPrompts": today_prompts,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_tokens,
    "todayTokensByModel": today_models,
    "recentDays": [{"date": k, "messageCount": v} for k, v in recent_days.items()],
    "activeDays": sum(1 for v in recent_days.values() if v > 0),
    "activeDates": [k for k, v in recent_days.items() if v > 0],
    "modelUsage": model_breakdown if model_breakdown else {
        "Big Pickle": {
            "inputTokens": 0,
            "outputTokens": 0,
            "cacheReadInputTokens": 0,
            "cacheCreationInputTokens": 0
        }
    },
    "limits": [
        {
            "label": "Session",
            "percent": 0.15,
            "resetsAt": window_reset
        }
    ],
    "usageStatusText": ""
}
print(json.dumps(record))

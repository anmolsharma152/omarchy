#!/bin/bash
# omarchy:summary=Cycle active workspaces (next/prev) or jump to first/last active workspace
# omarchy:args=[next|prev|first|last] [--move-window]

direction="${1:-next}"
move_window="${2:-}"

# Get current workspace ID
current=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id' 2>/dev/null)
if ! [[ "$current" =~ ^[0-9]+$ ]] || (( current < 1 || current > 10 )); then
  current=1
fi

mapfile -t active_ws < <(hyprctl workspaces -j 2>/dev/null | jq -r '[.[] | select(.id > 0 and .id <= 10) | .id] | sort | .[]')
total=${#active_ws[@]}

if [[ "$move_window" == "--move-window" ]]; then
  if [[ "$direction" == "first" ]]; then
    target=${active_ws[0]:-1}
  elif [[ "$direction" == "last" ]]; then
    target=${active_ws[-1]:-10}
  elif [[ "$direction" == "next" ]]; then
    if (( current >= 10 )); then target=1; else target=$((current + 1)); fi
  else
    if (( current <= 1 )); then target=10; else target=$((current - 1)); fi
  fi
  hyprctl eval "hl.dispatch(hl.dsp.window.move({ workspace = '${target}' }))" >/dev/null 2>&1 || true
else
  if (( total == 0 )); then
    exit 0
  fi

  if [[ "$direction" == "first" ]]; then
    target=${active_ws[0]}
  elif [[ "$direction" == "last" ]]; then
    target=${active_ws[-1]}
  else
    if (( total <= 1 )); then
      exit 0
    fi

    idx=-1
    for i in "${!active_ws[@]}"; do
      if (( active_ws[i] == current )); then
        idx=$i
        break
      fi
    done

    if (( idx == -1 )); then
      target=${active_ws[0]}
    else
      if [[ "$direction" == "next" ]]; then
        next_idx=$(((idx + 1) % total))
        target=${active_ws[$next_idx]}
      else
        prev_idx=$(((idx - 1 + total) % total))
        target=${active_ws[$prev_idx]}
      fi
    fi
  fi

  hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = '${target}' }))" >/dev/null 2>&1 || true
fi

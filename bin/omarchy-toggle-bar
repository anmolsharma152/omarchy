#!/bin/bash
# Toggle bar visibility in Omarchy Quickshell

mkdir -p "$HOME/.local/state/omarchy/toggles"
FLAG="$HOME/.local/state/omarchy/toggles/bar-off"
if [[ -f "$FLAG" ]]; then
  rm -f "$FLAG"
  omarchy-notification-send -g 󰛖 "Top Bar Visible" -t 1500 2>/dev/null || true
else
  touch "$FLAG"
  omarchy-notification-send -g 󰛖 "Top Bar Hidden" -t 1500 2>/dev/null || true
fi
touch "$HOME/.local/state/omarchy/toggles"
